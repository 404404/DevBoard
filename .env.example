CODEXBOARD_ENV=production
CODEXBOARD_AUTH_MODE=web
DEVBOARD_PUBLIC_ORIGIN=https://devboard.example.com
# Explicit proxy IP/CIDR only. Keep empty until the reverse proxy's observed source is known.
DEVBOARD_TRUST_PROXY=
DEVBOARD_BIND_ADDRESS=127.0.0.1
DEVBOARD_IMAGE=ghcr.io/404404/devboard:preview
DEVBOARD_DATA_DIR=/var/lib/devboard
CODEXBOARD_HOST=0.0.0.0
CODEXBOARD_PORT=47823
CODEXBOARD_ADMIN_HOST=127.0.0.1
CODEXBOARD_ADMIN_PORT=47824
CODEXBOARD_LOG_LEVEL=info
TZ=Asia/Hong_Kong

# Optional Feishu/Lark credentials. Prefer a mode-0600 JSON file mounted read-only:
# CODEXBOARD_AUTH_MODE=feishu
# CODEXBOARD_FEISHU_CREDENTIALS_FILE=/run/devboard/secrets/feishu-credentials.json
# Mount that file read-only in compose.yaml; never commit real credentials.

# Host-mounted SSH identities are selected by safe file name (identityRef), never by path.
# Put dedicated keys in ./secrets/ssh/identities; compose mounts this directory read-only.
DEVBOARD_SSH_IDENTITY_DIR=/run/devboard/ssh/identities
# Optional Docker Host SSH agent forwarding is configured by compose.ssh-agent.yaml.

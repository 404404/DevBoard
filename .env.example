LARK_CODEX_ENV=development
LARK_CODEX_AUTH_MODE=development
LARK_CODEX_HOST=127.0.0.1
LARK_CODEX_PORT=47823
LARK_CODEX_ADMIN_HOST=127.0.0.1
LARK_CODEX_ADMIN_PORT=47824
LARK_CODEX_ORIGIN=http://localhost:5173
LARK_CODEX_ALLOWED_HOSTS=127.0.0.1:47823,localhost:47823
LARK_CODEX_LOG_LEVEL=info
LARK_CODEX_DATA_DIR=.data
# 生产模式托管已构建 H5 的目录；开发模式由 Vite 提供页面：
LARK_CODEX_WEB_ROOT=apps/web/dist
# 单个附件上限，默认 25 MiB：
LARK_CODEX_ATTACHMENT_MAX_BYTES=26214400
# 正常环境保持默认 codex；仅协议测试可覆盖：
# LARK_CODEX_CODEX_COMMAND=codex
# 逗号分隔的绝对目录；未配置时仅允许当前仓库父目录：
# LARK_CODEX_WORKSPACE_ROOTS=/absolute/path/to/projects
# 临时项目创建与展示共用的根目录；开发调试可覆盖默认根目录：
# LARK_CODEX_TEMPORARY_PROJECT_ROOT=/absolute/path/to/Codex
LARK_CODEX_SESSION_TTL_SECONDS=28800
# 部署阶段启用 feishu 模式时再配置，禁止提交真实值：
# LARK_CODEX_FEISHU_APP_ID=
# LARK_CODEX_FEISHU_APP_SECRET=
# 生产部署优先使用权限为 0600 的 JSON 凭据文件（appId、appSecret）：
# 不能与上面的明文变量或下方旧版 Secret 文件同时配置。
# LARK_CODEX_FEISHU_CREDENTIALS_FILE=/absolute/path/to/secrets/feishu-credentials.json
# 旧版兼容：与 LARK_CODEX_FEISHU_APP_ID 配合，不能同时配置明文 Secret。
# LARK_CODEX_FEISHU_APP_SECRET_FILE=/absolute/path/to/secrets/feishu-app-secret

# macOS 后端内嵌桥接：
# LARK_CODEX_CODEX_TRANSPORT=embedded
# LARK_CODEX_CODEX_COMMAND=/Applications/Codex.app/Contents/Resources/codex
# LARK_CODEX_CODEX_PROJECT_STATE_FILE=/absolute/path/to/.codex-global-state.json

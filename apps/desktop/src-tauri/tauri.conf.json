{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lark-Codex",
  "version": "0.1.2",
  "identifier": "cn.rocyan.larkcodex.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lark-Codex",
        "width": 1000,
        "height": 730,
        "minWidth": 780,
        "minHeight": 580,
        "backgroundColor": "#f7f8fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDQTM5MkIzNEYxNDg0OTUKUldTVmhCUlBzNUtqVEwwUGUxdk1YNjFUZWwxZys0MC9MM0lITEVtNUttMmhHUmN0Y3FrRXdCRVgK",
      "endpoints": ["https://github.com/RocYan98/Lark-Codex/releases/latest/download/latest.json"]
    }
  }
}
